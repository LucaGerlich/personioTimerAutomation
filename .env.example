# === Server ===
PORT=3000

# === Authentication ===
# Generate a strong random token: openssl rand -hex 32
TRIGGER_TOKEN=change-me-to-a-long-random-string

# === Personio ===
PERSONIO_URL=https://your-company.personio.de
PERSONIO_EMAIL=your.email@company.com
PERSONIO_PASSWORD=your-password-here

# === Playwright ===
# Set to "true" for headless mode (production), "false" for debugging
HEADLESS=true

# === Safety Guards ===
# Minutes to wait before allowing another trigger (prevents duplicate starts)
COOLDOWN_MINUTES=15
# Allowed time window for /trigger/start (24h format, in TIMEZONE)
ALLOWED_START_HOUR=5
ALLOWED_END_HOUR=12
# Allowed time window for /trigger/break and /trigger/resume
BREAK_START_HOUR=12
BREAK_END_HOUR=14
# Timezone for time-window calculations
TIMEZONE=Europe/Berlin
